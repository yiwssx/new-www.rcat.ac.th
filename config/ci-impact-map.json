{
  "version": 1,
  "lanes": ["dependencies", "static-quality", "unit", "integration", "build", "governance", "worker", "functional"],
  "rules": [
    {
      "id": "critical-runtime-config",
      "exact": [
        "package.json",
        "pnpm-lock.yaml",
        "pnpm-workspace.yaml",
        "vercel.json",
        "vite.config.ts",
        "tsconfig.json",
        "src/routes.tsx",
        "src/entry-client.tsx",
        "src/entry-server.tsx",
        "src/vercelSsr.ts",
        "src/AppProviders.tsx",
        "src/test/setup.ts",
        "config/ci-impact-map.json"
      ],
      "prefix": [".github/workflows/", ".github/actions/", "scripts/ci/", "api/"],
      "full": true,
      "areas": ["infrastructure"]
    },
    {
      "id": "cms-auth",
      "exact": [
        "src/context/AuthContext.tsx",
        "src/context/authSessionContext.ts",
        "src/cmsAuthRouteComponents.tsx",
        "src/admin/pages/LoginPage.tsx",
        "src/admin/pages/AccountSecurityPage.tsx",
        "src/admin/pages/ResetPasswordPage.tsx"
      ],
      "prefix": ["server/cmsAuth/", "src/features/cms-auth/"],
      "areas": ["admin", "auth"],
      "lanes": ["static-quality", "unit", "integration", "build", "governance", "functional"]
    },
    {
      "id": "theme-design",
      "exact": ["src/theme.ts", "src/styles.css"],
      "prefix": ["src/design-system/"],
      "areas": ["public", "admin", "design"],
      "lanes": ["static-quality", "unit", "build", "governance", "functional"]
    },
    {
      "id": "backend-private-observability-and-retention",
      "exact": ["cloudflare/public-api/src/db/d1QueryUsage.ts", "cloudflare/public-api/src/analyticsRetention.ts"],
      "areas": ["backend", "data-internal"],
      "lanes": ["static-quality", "unit", "integration", "worker", "governance"]
    },
    {
      "id": "backend-public-response-consumer",
      "exact": [
        "cloudflare/public-api/src/routes/publicHome.ts",
        "cloudflare/public-api/src/routes/publicContent.ts",
        "cloudflare/public-api/src/routes/publicDocuments.ts",
        "cloudflare/public-api/src/routes/publicEvents.ts",
        "cloudflare/public-api/src/routes/publicPrograms.ts",
        "cloudflare/public-api/src/routes/publicSearch.ts",
        "cloudflare/public-api/src/routes/publicShell.ts"
      ],
      "areas": ["backend", "public", "api-contract"],
      "lanes": ["static-quality", "unit", "integration", "build", "governance", "worker", "functional"]
    },
    {
      "id": "backend-admin-menu-crud-consumers",
      "exact": ["cloudflare/public-api/src/routes/adminMenuMutations.ts"],
      "areas": ["backend", "admin", "public", "crud-contract"],
      "lanes": ["static-quality", "unit", "integration", "build", "governance", "worker", "functional"]
    },
    {
      "id": "schema-and-migration-cross-consumers",
      "exact": ["cloudflare/public-api/src/db/schema.ts"],
      "prefix": ["cloudflare/public-api/migrations/"],
      "areas": ["database", "shared"],
      "full": true
    },
    {
      "id": "worker-source-unknown-contract-impact",
      "prefix": ["cloudflare/public-api/src/"],
      "full": true,
      "areas": ["shared"]
    },
    {
      "id": "worker-tests",
      "prefix": ["cloudflare/public-api/test/"],
      "areas": ["worker"],
      "lanes": ["static-quality", "unit", "integration", "worker"]
    },
    {
      "id": "worker-d1",
      "prefix": ["cloudflare/public-api/"],
      "areas": ["worker"],
      "lanes": ["static-quality", "unit", "integration", "worker", "governance"]
    },
    {
      "id": "integration-tests",
      "prefix": ["src/test/integration/"],
      "areas": ["integration"],
      "lanes": ["static-quality", "integration"]
    },
    {
      "id": "unit-tests",
      "prefix": ["src/test/"],
      "areas": ["unit"],
      "lanes": ["static-quality", "unit"]
    },
    {
      "id": "functional-tests",
      "prefix": ["tests/functional/", "tests/production/"],
      "areas": ["functional"],
      "lanes": ["static-quality", "functional"]
    },
    {
      "id": "public",
      "prefix": ["src/public/", "src/features/public-"],
      "areas": ["public"],
      "lanes": ["static-quality", "unit", "build", "governance", "functional"]
    },
    {
      "id": "admin",
      "prefix": ["src/admin/", "src/features/admin-"],
      "areas": ["admin"],
      "lanes": ["static-quality", "unit", "integration", "build", "functional"]
    },
    {
      "id": "shared",
      "exact": ["src/types.ts"],
      "prefix": ["src/shared/", "src/services/", "src/features/cms-settings/"],
      "full": true,
      "areas": ["shared"]
    },
    {
      "id": "frontend-cms-features",
      "prefix": [
        "src/features/cms-carousel/",
        "src/features/cms-dashboard/",
        "src/features/cms-documents/",
        "src/features/cms-events/",
        "src/features/cms-media/",
        "src/features/cms-content/",
        "src/features/cms-navigation/",
        "src/features/cms-external-services/",
        "src/features/organization-admin/",
        "src/features/admin-pagination/"
      ],
      "areas": ["frontend", "admin"],
      "lanes": ["static-quality", "unit", "integration", "build", "functional"]
    },
    {
      "id": "docs",
      "exact": ["README.md", "CHANGELOG.md", "CONTRIBUTING.md"],
      "prefix": ["docs/"],
      "areas": ["documentation"],
      "lanes": ["static-quality"]
    },
    {
      "id": "calendar-source-related",
      "exact": ["src/utils/calendar.ts"],
      "areas": ["admin"],
      "lanes": ["static-quality", "unit", "integration", "build", "governance", "functional"]
    },
    {
      "id": "critical-remaining",
      "prefix": [
        "server/",
        "src/context/",
        "src/config/",
        "src/features/cms-",
        "scripts/",
        ".github/",
        "config/",
        "src/"
      ],
      "full": true,
      "areas": ["unknown"]
    }
  ]
}
