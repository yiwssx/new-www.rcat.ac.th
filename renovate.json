{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "security:minimumReleaseAgeNpm"],
  "dependencyDashboard": true,
  "enabledManagers": ["npm", "github-actions"],
  "includePaths": ["package.json", ".github/workflows/**", ".github/actions/**"],
  "baseBranchPatterns": ["main"],
  "timezone": "Asia/Bangkok",
  "schedule": ["* 0-6 * * *"],
  "updateNotScheduled": false,
  "automergeSchedule": ["* 0-6 * * *"],
  "labels": ["dependencies"],
  "semanticCommits": "enabled",
  "semanticCommitType": "chore",
  "semanticCommitScope": "deps",
  "rangeStrategy": "update-lockfile",
  "pinDigests": false,
  "rebaseWhen": "behind-base-branch",
  "recreateWhen": "auto",
  "automergeStrategy": "squash",
  "platformAutomerge": false,
  "ignoreTests": false,
  "prConcurrentLimit": 3,
  "branchConcurrentLimit": 3,
  "prHourlyLimit": 2,
  "commitHourlyLimit": 4,
  "lockFileMaintenance": {
    "enabled": false
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Manage only direct dependencies declared in the root package.json",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "enabled": true
    },
    {
      "description": "Do not manage runtime metadata, package-manager metadata, overrides, peers, or other non-direct dependency fields",
      "matchManagers": ["npm"],
      "matchFileNames": ["package.json"],
      "matchDepTypes": [
        "engines",
        "packageManager",
        "optionalDependencies",
        "peerDependencies",
        "resolutions",
        "overrides",
        "pnpm",
        "pnpm.overrides",
        "pnpm-workspace.overrides"
      ],
      "enabled": false
    },
    {
      "description": "Automatically merge stable patch and minor direct npm updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "minor"],
      "automerge": true,
      "automergeType": "pr"
    },
    {
      "description": "Group otherwise-unclassified stable runtime patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies"],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "other runtime dependencies"
    },
    {
      "description": "Group otherwise-unclassified stable development patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchDepNames": ["!typescript", "!@typescript/native", "!@types/node", "!jsdom"],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "other development dependencies"
    },
    {
      "description": "Keep TypeScript within the installed typescript-eslint peer range",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": ["typescript"],
      "allowedVersions": ">=4.8.4 <6.1.0"
    },
    {
      "description": "Keep Node declarations aligned with the Node 24 runtime",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": ["@types/node"],
      "allowedVersions": ">=24.0.0 <25.0.0",
      "rangeStrategy": "bump"
    },
    {
      "description": "Update React and React DOM together to preserve version alignment",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react", "react-dom"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "react runtime"
    },
    {
      "description": "Update Vitest and coverage tooling together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["vitest", "@vitest/coverage-v8"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "vitest toolchain"
    },
    {
      "description": "Keep both dnd-kit packages aligned; zero-major manual-review protection still applies",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@dnd-kit/react", "@dnd-kit/helpers"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "dnd-kit"
    },
    {
      "description": "Group compatible Cloudflare toolchain patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": ["wrangler", "@cloudflare/workers-types"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "cloudflare toolchain"
    },
    {
      "description": "Group compatible TanStack runtime patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchPackageNames": ["@tanstack/react-query", "@tanstack/react-router", "@tanstack/react-table"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "tanstack runtime"
    },
    {
      "description": "Group Vite build tooling patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["vite", "@vitejs/plugin-react", "vite-plugin-checker"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "vite build tooling"
    },
    {
      "description": "Group formatting tooling patch and minor updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["prettier", "eslint-config-prettier", "lint-staged"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "formatting tooling"
    },
    {
      "description": "Keep React type declarations aligned within the React major",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@types/react", "@types/react-dom"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "react type declarations"
    },
    {
      "description": "Update form state, validation, and resolver integrations together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["react-hook-form", "@hookform/resolvers", "zod"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "form validation"
    },
    {
      "description": "Update MUI component libraries as a compatible group",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@mui/material", "@mui/icons-material", "@mui/x-tree-view"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "mui components"
    },
    {
      "description": "Update Emotion styling packages together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@emotion/cache", "@emotion/react", "@emotion/server", "@emotion/styled"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "emotion styling"
    },
    {
      "description": "Keep editor packages in one coherent Tiptap update",
      "matchManagers": ["npm"],
      "matchPackageNames": ["/^@tiptap\\//"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "tiptap editor"
    },
    {
      "description": "Group Vercel runtime and observability integrations",
      "matchManagers": ["npm"],
      "matchPackageNames": ["@vercel/analytics", "@vercel/functions", "@vercel/speed-insights"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "vercel runtime"
    },
    {
      "description": "Group Playwright and accessibility browser test dependencies",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["@playwright/test", "@axe-core/playwright"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "browser testing"
    },
    {
      "description": "Group Testing Library utilities without coupling them to browser testing",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "@testing-library/jest-dom",
        "@testing-library/react",
        "@testing-library/user-event"
      ],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "testing library"
    },
    {
      "description": "Keep Tailwind CSS and its PostCSS integration together",
      "matchManagers": ["npm"],
      "matchPackageNames": ["tailwindcss", "@tailwindcss/postcss", "postcss"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "css styling"
    },
    {
      "description": "Group stable ESLint ecosystem maintenance",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": [
        "eslint",
        "@eslint/js",
        "typescript-eslint",
        "eslint-plugin-react-hooks",
        "eslint-plugin-react-refresh",
        "globals"
      ],
      "matchCurrentVersion": "!/^0/",
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "eslint tooling"
    },
    {
      "description": "Keep commitlint CLI and its conventional rule set aligned",
      "matchManagers": ["npm"],
      "matchDepTypes": ["devDependencies"],
      "matchPackageNames": ["@commitlint/cli", "@commitlint/config-conventional"],
      "matchUpdateTypes": ["patch", "minor"],
      "groupName": "commitlint tooling"
    },
    {
      "description": "Keep workflow pnpm setup pinned for deliberate package-manager upgrades",
      "matchManagers": ["github-actions"],
      "matchPackageNames": ["pnpm"],
      "enabled": false
    },
    {
      "description": "Manage GitHub Actions by version tags and automatically merge updates after CI",
      "matchManagers": ["github-actions"],
      "pinDigests": false,
      "automerge": true,
      "automergeType": "pr",
      "addLabels": ["github-actions"],
      "groupName": "github actions"
    },
    {
      "description": "Require manual review for major direct npm updates",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update", "manual-review"]
    },
    {
      "description": "Require manual review for unstable zero-major direct packages",
      "matchManagers": ["npm"],
      "matchDepTypes": ["dependencies", "devDependencies"],
      "matchCurrentVersion": "/^0\\./",
      "automerge": false,
      "addLabels": ["unstable-package", "manual-review"]
    }
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["dependencies", "security"],
    "prConcurrentLimit": 2
  },
  "gitIgnoredAuthors": ["41898282+github-actions[bot]@users.noreply.github.com"]
}
