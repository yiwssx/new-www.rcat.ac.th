{
  "name": "rcat-cms-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prepare": "husky",
    "ai:map": "sigmap",
    "ai:codex": "sigmap --adapter codex",
    "ai:copilot": "sigmap --adapter copilot",
    "ai:health": "sigmap --health",
    "ai:ask": "sigmap ask",
    "ai:validate": "sigmap validate",
    "build": "node scripts/generate-sitemap.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "worker:dev": "wrangler dev --config cloudflare/public-api/wrangler.toml",
    "worker:deploy:dry": "wrangler deploy --config cloudflare/public-api/wrangler.toml --dry-run",
    "worker:typecheck": "tsc -p cloudflare/public-api/tsconfig.json --noEmit",
    "worker:d1:migrate:local": "wrangler d1 migrations apply rcat-public-api-local --local --config cloudflare/public-api/wrangler.toml",
    "worker:d1:seed:local": "wrangler d1 execute rcat-public-api-local --local --file cloudflare/public-api/seed/public-documents.seed.sql --config cloudflare/public-api/wrangler.toml",
    "worker:d1:list:local": "wrangler d1 execute rcat-public-api-local --local --command \"SELECT id, title, status, pinned, sort_order FROM documents ORDER BY pinned DESC, sort_order ASC, published_at DESC\" --config cloudflare/public-api/wrangler.toml",
    "worker:preview:preflight": "node cloudflare/public-api/scripts/preview-smoke-preflight.mjs",
    "worker:production:preflight": "node cloudflare/public-api/scripts/production-cutover-preflight.mjs",
    "worker:public-documents:import:dry-run": "node cloudflare/public-api/scripts/public-documents-import-dry-run.mjs",
    "worker:public-documents:import:manifest": "node cloudflare/public-api/scripts/public-documents-import-manifest-dry-run.mjs",
    "worker:public-documents:import:prod": "node cloudflare/public-api/scripts/public-documents-production-import.mjs",
    "worker:public-documents:worker-smoke": "node cloudflare/public-api/scripts/public-documents-production-worker-smoke.mjs",
    "worker:public-documents:cutover": "node cloudflare/public-api/scripts/public-documents-production-cutover.mjs",
    "worker:public-read:preview-smoke": "node cloudflare/public-api/scripts/public-read-preview-smoke.mjs",
    "worker:admin-write:preview-smoke": "node cloudflare/public-api/scripts/admin-write-preview-smoke.mjs",
    "worker:m19:readiness": "node cloudflare/public-api/scripts/m19-parity-readiness.mjs",
    "worker:m20:readiness": "node cloudflare/public-api/scripts/m20-readiness-gate.mjs",
    "facebook:export:posts": "node scripts/facebook/export-page-posts.mjs --since 2023-01-01 --until 2026-07-31 --chunk-days 30 --limit 25 --output imports/facebook-posts-2023-2026.raw.json",
    "facebook:export:posts:small": "node scripts/facebook/export-page-posts.mjs --since 2026-07-01 --until 2026-07-31 --chunk-days 7 --limit 10 --output imports/facebook-posts-test.raw.json",
    "facebook:transform:sql": "node scripts/facebook/transform-posts-to-d1-sql.mjs --input imports/facebook-posts-2023-2026.raw.json --output imports/facebook-news-2023-2026.sql --status published --batch-size 100 --max-body-chars 12000",
    "facebook:import:preview": "pnpm wrangler d1 execute rcat-public-api-preview --remote --env preview --config cloudflare/public-api/wrangler.toml --file ./imports/facebook-news-2023-2026.sql",
    "facebook:import:preview:part1": "pnpm wrangler d1 execute rcat-public-api-preview --remote --env preview --config cloudflare/public-api/wrangler.toml --file ./imports/facebook-news-2023-2026.part-001.sql",
    "test": "node scripts/run-vitest.mjs run",
    "test:unit": "node scripts/run-vitest.mjs run --exclude src/test/integration/**",
    "test:integration": "node scripts/run-vitest.mjs run src/test/integration",
    "test:functional:install": "playwright install chromium",
    "test:functional": "playwright test",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:functional",
    "gas:login": "pnpm dlx @google/clasp login",
    "gas:push": "cd apps-script && pnpm dlx @google/clasp push --force",
    "gas:version": "cd apps-script && pnpm dlx @google/clasp version \"release latest\"",
    "gas:deployments": "cd apps-script && pnpm dlx @google/clasp deployments",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"server/**/*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"server/**/*.{js,mjs}\" --fix",
    "lint:errors": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"server/**/*.{js,mjs}\" --quiet",
    "lint:report": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"server/**/*.{js,mjs}\" --format stylish",
    "lint:strict": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" \"api/**/*.{js,mjs}\" \"server/**/*.{js,mjs}\" --max-warnings=0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm format:check && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build",
    "quality:full": "pnpm format:check && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build && pnpm worker:typecheck",
    "quality:release": "pnpm quality:full && pnpm test:functional",
    "deps:check": "pnpm outdated && pnpm audit",
    "deps:update:minor": "pnpm dlx npm-check-updates --target minor -u && pnpm install",
    "deps:update:latest": "pnpm dlx npm-check-updates --target latest -u && pnpm install",
    "warning:baseline": "pnpm format:check && pnpm lint:report && pnpm test:unit && pnpm test:integration && pnpm build && pnpm worker:typecheck",
    "lint-staged": "lint-staged",
    "commitlint": "commitlint --edit"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^6.5.0",
    "@mui/material": "^6.5.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.17",
    "@tanstack/react-table": "^8.21.3",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.21",
    "embla-carousel-react": "^8.6.0",
    "jose": "^6.2.3",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.26.25"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260702.1",
    "@commitlint/cli": "21.2.0",
    "@commitlint/config-conventional": "21.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "husky": "^9.1.7",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.0.8",
    "postcss": "^8.5.16",
    "prettier": "^3.9.4",
    "sigmap": "^6.15.0",
    "tailwindcss": "^4.3.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.63.0",
    "vite": "^6.4.3",
    "vite-plugin-checker": "^0.14.4",
    "vitest": "^3.2.7",
    "wrangler": "^4.107.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,html,yml,yaml}": [
      "prettier --write"
    ]
  }
}
