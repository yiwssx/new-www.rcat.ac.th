{
  "name": "rcat-cms-template",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node scripts/generate-sitemap.mjs && tsc --noEmit -p tsconfig.json && vite build",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --exclude src/test/integration/**",
    "test:integration": "vitest run src/test/integration",
    "test:functional:install": "playwright install chromium",
    "test:functional": "playwright test",
    "test:all": "pnpm test:unit && pnpm test:integration && pnpm test:functional",
    "gas:login": "pnpm dlx @google/clasp login",
    "gas:push": "cd apps-script && pnpm dlx @google/clasp push --force",
    "gas:version": "cd apps-script && pnpm dlx @google/clasp version \"release latest\"",
    "gas:deployments": "cd apps-script && pnpm dlx @google/clasp deployments",
    "lint": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" --fix",
    "lint:errors": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" --quiet",
    "lint:report": "eslint \"src/**/*.{ts,tsx}\" \"scripts/**/*.{js,mjs}\" --format stylish",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm format:check && pnpm lint && pnpm test:unit && pnpm test:integration && pnpm build"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@mui/icons-material": "^6.4.7",
    "@mui/material": "^6.4.7",
    "@tanstack/react-query": "^5.66.9",
    "@tanstack/react-router": "^1.168.24",
    "@tanstack/react-table": "^8.21.2",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "bcryptjs": "^2.4.3",
    "dayjs": "^1.11.13",
    "jwt-decode": "^4.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sweetalert2": "^11.26.24"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4.2.4",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "jsdom": "^26.0.0",
    "postcss": "^8.5.10",
    "prettier": "^3.8.3",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^6.1.0",
    "vitest": "^3.0.7"
  },
  "packageManager": "pnpm@10.0.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
