{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "pnpm build && pnpm exec vite build --ssr src/vercelSsr.ts --outDir server-build --emptyOutDir && node scripts/prepare-ssr-cutover-output.mjs",
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/vercel-ignore-build.mjs",
  "git": {
    "deploymentEnabled": {
      "master": true,
      "**": false
    }
  },
  "functions": {
    "api/ssr.ts": {
      "supportsCancellation": true,
      "maxDuration": 15
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'self'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self' data:; connect-src 'self' https://*.workers.dev https://*.rcat.ac.th https://www.google-analytics.com https://region1.google-analytics.com https://www.googletagmanager.com; frame-src https://www.facebook.com https://www.youtube.com https://www.youtube-nocookie.com https://www.google.com https://docs.google.com https://drive.google.com; media-src 'self' blob: https:; worker-src 'self' blob:; manifest-src 'self'; report-uri /api/csp-report"
        },
        {
          "key": "X-RCAT-Security-Baseline",
          "value": "p6b-enforced-v1"
        }
      ]
    },
    {
      "source": "/csr.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/fonts/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/api/csp-report",
      "destination": "/api/complaint?_rcatComplaintRoute=csp-report"
    },
    {
      "source": "/api/cms-auth/login",
      "destination": "/api/cms-auth?_rcatCmsRoute=login"
    },
    {
      "source": "/api/cms-auth/session",
      "destination": "/api/cms-auth?_rcatCmsRoute=session"
    },
    {
      "source": "/api/cms-auth/logout",
      "destination": "/api/cms-auth?_rcatCmsRoute=logout"
    },
    {
      "source": "/api/cms-auth/logout-all",
      "destination": "/api/cms-auth?_rcatCmsRoute=logout-all"
    },
    {
      "source": "/api/cms-auth/change-password",
      "destination": "/api/cms-auth?_rcatCmsRoute=change-password"
    },
    {
      "source": "/api/cms-auth/invitation/inspect",
      "destination": "/api/cms-auth?_rcatCmsRoute=invitation-inspect"
    },
    {
      "source": "/api/cms-auth/invitation/accept",
      "destination": "/api/cms-auth?_rcatCmsRoute=invitation-accept"
    },
    {
      "source": "/api/cms-auth/password-reset/inspect",
      "destination": "/api/cms-auth?_rcatCmsRoute=password-reset-inspect"
    },
    {
      "source": "/api/cms-auth/password-reset/complete",
      "destination": "/api/cms-auth?_rcatCmsRoute=password-reset-complete"
    },
    {
      "source": "/api/cms-auth/mfa/verify",
      "destination": "/api/cms-auth?_rcatCmsRoute=mfa-verify"
    },
    {
      "source": "/api/cms-auth/mfa/setup/start",
      "destination": "/api/cms-auth?_rcatCmsRoute=mfa-setup-start"
    },
    {
      "source": "/api/cms-auth/mfa/setup/confirm",
      "destination": "/api/cms-auth?_rcatCmsRoute=mfa-setup-confirm"
    },
    {
      "source": "/api/cms-auth/mfa/recovery-codes/regenerate",
      "destination": "/api/cms-auth?_rcatCmsRoute=mfa-recovery-regenerate"
    },
    {
      "source": "/api/cms-auth/mfa",
      "destination": "/api/cms-auth?_rcatCmsRoute=mfa-disable"
    },
    {
      "source": "/api/cms-auth/reauthenticate",
      "destination": "/api/cms-auth?_rcatCmsRoute=reauthenticate"
    },
    {
      "source": "/api/admin-proxy-session/login",
      "destination": "/api/cms-auth?_rcatCmsRoute=retired-admin-proxy-login"
    },
    {
      "source": "/api/admin-proxy-session/logout",
      "destination": "/api/cms-auth?_rcatCmsRoute=retired-admin-proxy-logout"
    },
    {
      "source": "/login",
      "destination": "/csr.html"
    },
    {
      "source": "/activate-account",
      "destination": "/csr.html"
    },
    {
      "source": "/reset-password",
      "destination": "/csr.html"
    },
    {
      "source": "/admin",
      "destination": "/csr.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/csr.html"
    },
    {
      "source": "/(.*)",
      "destination": "/api/ssr?_rcatPath=/$1"
    }
  ]
}
