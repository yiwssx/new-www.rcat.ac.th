VITE_CMS_SITE_NAME="YOUR_SITE_NAME"
VITE_PUBLIC_SITE_URL="YOUR_PUBLIC_SITE_URL"
VITE_PUBLIC_API_PROVIDER="cloudflare"
VITE_CLOUDFLARE_PUBLIC_API_URL="YOUR_CLOUDFLARE_WORKER_URL"
VITE_COMPLAINT_API_URI="YOUR_COMPLAINT_APPS_SCRIPT_EXEC_URL"

# Shared server-only secret configured in both Vercel and the Cloudflare Worker.
CMS_AUTH_PROXY_SECRET="YOUR_SERVER_ONLY_RANDOM_SECRET"

# Vercel server-only CMS proxy and media bridge configuration.
CLOUDFLARE_ADMIN_API_URL="YOUR_CLOUDFLARE_WORKER_URL"
GOOGLE_APPS_SCRIPT_URL="YOUR_APPS_SCRIPT_EXEC_URL"
APPS_SCRIPT_BRIDGE_TOKEN="YOUR_SERVER_ONLY_BRIDGE_TOKEN"

# Cloudflare Worker-only CMS authentication configuration.
ADMIN_WRITE_ALLOWED_ORIGINS="YOUR_ALLOWED_ADMIN_ORIGINS"
CMS_MFA_ENCRYPTION_KEY="YOUR_SERVER_ONLY_MFA_ENCRYPTION_KEY"
CMS_MFA_ENCRYPTION_KEY_VERSION="YOUR_MFA_KEY_VERSION"
