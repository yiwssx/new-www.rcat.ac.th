{
  "site": {
    "name": "วิทยาลัยเกษตรและเทคโนโลยีร้อยเอ็ด",
    "publicSiteUrl": "https://www.rcat.ac.th",
    "language": "th",
    "locale": "th-TH",
    "logoPath": "/rcat-logo-128.png",
    "logoAlt": "ตราสัญลักษณ์ RCAT"
  },
  "query": {
    "staleTimeMs": 300000,
    "gcTimeMs": 900000,
    "retry": 0,
    "refetchOnMount": false,
    "refetchOnReconnect": true,
    "refetchOnWindowFocus": false
  },
  "storageKeys": {
    "session": "rcat.cms.session",
    "displaySettings": "rcat.cms.display.settings"
  },
  "auth": {
    "sessionHours": 8
  },
  "roles": [
    {
      "id": "role-admin",
      "role": "ผู้ดูแลระบบ",
      "scope": "ทุกชุดข้อมูล",
      "canPublish": true,
      "canManageUsers": true
    },
    {
      "id": "role-editor",
      "role": "บรรณาธิการ",
      "scope": "งานที่ได้รับมอบหมาย",
      "canPublish": true,
      "canManageUsers": false
    },
    {
      "id": "role-viewer",
      "role": "ผู้เข้าชม",
      "scope": "อ่านข้อมูลเท่านั้น",
      "canPublish": false,
      "canManageUsers": false
    }
  ],
  "theme": {
    "palette": {
      "primaryMain": "#2c7a3f",
      "primaryLight": "#e8f5e9",
      "primaryDark": "#1f5a2c",
      "secondaryMain": "#b88700",
      "secondaryLight": "#fff4c2",
      "secondaryDark": "#7a5900",
      "successMain": "#3f8f49",
      "successLight": "#e5f4e7",
      "successDark": "#2a6232",
      "warningMain": "#d6a11a",
      "warningLight": "#fff0b3",
      "warningDark": "#8c6500",
      "errorMain": "#c84d3a",
      "errorLight": "#fde9e5",
      "errorDark": "#973728",
      "backgroundDefault": "#f8fbf2",
      "paper": "#ffffff",
      "textPrimary": "#203324",
      "textSecondary": "#5c6d60"
    },
    "shape": {
      "borderRadius": 8
    },
    "typography": {
      "fontFamily": ["\"Sarabun\"", "\"Noto Sans Thai\"", "\"Segoe UI\"", "sans-serif"]
    }
  }
}
